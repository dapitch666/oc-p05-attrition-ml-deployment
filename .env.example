# Copy to .env and fill in. Never commit .env.
APP_ENV=dev

# The passwords end up inside connection URLs: they must not contain @, / or :.
POSTGRES_USER=attrition
POSTGRES_PASSWORD=change-me
POSTGRES_DB=attrition
# Interface the API port is published on; use 0.0.0.0 to expose it on the network.
API_BIND=127.0.0.1

# Password of the attrition_app role, which the init step creates. The API connects with it.
APP_DB_PASSWORD=change-me-too
# Owner connection, used by the init step and by the key management commands.
DATABASE_ADMIN_URL=postgresql+psycopg://attrition:change-me@localhost:5432/attrition
# Application role connection, used by the API. localhost for tools run from the host.
DATABASE_URL=postgresql+psycopg://attrition_app:change-me-too@localhost:5432/attrition
# Separate database for pytest, created by the test setup if missing. Its name must end with _test.
TEST_DATABASE_URL=postgresql+psycopg://attrition:change-me@localhost:5432/attrition_test
